% numeració contínua d'un sol nivell en el document
  \def\exercici@contnum{}


\ProcessOptions

\newcommand{\tdbend}{\raisebox{-1pt}[0pt][0pt]{\dbend}}

\ifdefined\exercici@contnum
   \newcounter{exercici}
   \renewcommand{\theexercici}{\arabic{exercici}}
   \newcounter{tasca}
   \renewcommand{\thetasca}{\arabic{tasca}}
\else
   \ifdefined\chapter
      \newcounter{exercici}[chapter]
      \renewcommand{\theexercici}{\thechapter.\arabic{exercici}}
      \newcounter{tasca}[chapter]
      \renewcommand{\thetasca}{\thechapter.\arabic{tasca}}
   \else
      \newcounter{exercici}[section]
      \renewcommand{\theexercici}{\thesection.\arabic{exercici}}
      \newcounter{tasca}[section]
      \renewcommand{\thetasca}{\thesection.\arabic{tasca}}
   \fi
\fi

%% Tasques d'un sol nivell de dificultat. Prèvies i no prèvies
\newenvironment{tasca}{%
  \goodbreak{}
  \begin{trivlist}\item[]%
    \refstepcounter{tasca}%
    \textsc{Tasca~\thetasca~}%
}{\end{trivlist}}

\newenvironment{previ}
  { \begin{list}{}{%
        \setlength{\rightmargin}{\leftmargin}
%        \setlength{\itemindent}{\leftmargin}
        \setlength{\topsep}{0.4\baselineskip}
        \setlength{\itemsep}{0pt}
      }
    \item[]
      \color{blue!70!black}
      \refstepcounter{tasca}
      \textsc{Tasca prèvia~\thetasca~}
    }
  {
     \end{list}
  }

\newenvironment{previous}
  { \begin{list}{}{%
        \setlength{\rightmargin}{\leftmargin}
%        \setlength{\itemindent}{\leftmargin}
        \setlength{\topsep}{0.4\baselineskip}
        \setlength{\itemsep}{0pt}
      }
    \item[]
      \color{blue!70!black}
    \refstepcounter{tasca}
      \textsc{Previous task~\thetasca~}
    }
  {
     \end{list}
       }
  
\newenvironment{task}
  { \begin{list}{}{%
        \setlength{\rightmargin}{\leftmargin}
%        \setlength{\itemindent}{\leftmargin}
        \setlength{\topsep}{0.4\baselineskip}
        \setlength{\itemsep}{0pt}
      }
    \item[]
      \color{black}
      \refstepcounter{tasca}
      \textsc{Task ~\thetasca~}
    }
  {
     \end{list}
  }


%% Exercicis de tres nivells de dificultat
\newenvironment{exercici}{%
  \goodbreak{}
  \begin{trivlist}\item[]%
    \refstepcounter{exercici}%
    \textsc{Exercici~\theexercici~}%
}{%
   \end{trivlist}
 }

\newenvironment{exercicid}{%
  \goodbreak{}
  \begin{trivlist}\item[]%
    \refstepcounter{exercici}%
    \makebox[0pt][r]{\tdbend\quad}%
    \textsc{Exercici~\theexercici~}%
}{\end{trivlist}}

\newenvironment{exercicidd}{%
  \goodbreak{}
  \begin{trivlist}\item[]%
    \refstepcounter{exercici}%
    \makebox[0pt][r]{\tdbend\kern2pt\tdbend\quad}%
    \textsc{Exercici~\theexercici~}%\par%
}{\end{trivlist}}


%% Solucions

\newenvironment{solucio}{%
  \goodbreak{}
  \begin{trivlist}\item[]%
    \small
    \textsc{Solució~exercici~\theexercici~}%
}{\end{trivlist}}


\relax

