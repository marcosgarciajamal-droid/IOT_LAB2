% The original template also defined an environment named "box"; with current
% tcolorbox that clashes with the TeX primitive \box, so only "upcbox" is kept.

\newtcolorbox{simplebox}{%
    enhanced,
    colback=blue!5!white,
    colframe=upcblue}

