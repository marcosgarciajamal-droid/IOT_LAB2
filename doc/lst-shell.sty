\ProvidesPackage{lst-shell}
\RequirePackage{lst-common}
\RequirePackage{xcolor}


%% package options

\DeclareOption{inlinebar}{%
  \lstMakeShortInline[language=bash,style=lst-common]{|}
}

\def\shell@background{\color{white}}
\DeclareOption{background}{%
  \def\shell@background{\color{upcblue!8!white}}
}

\lstdefinelanguage[]{mybash}[]{bash}{   
  literate= {à}{{\`a}}1 {è}{{\`e}}1 {é}{{\'e}}1 {í}{{\'\i}}1 {ï}{{\"\i}}1%
            {ò}{{\`o}}1 {ó}{{\'o}}1 {ú}{{\'u}}1 {ü}{{\"u}}1%
            {ç}{{\c{c}}}1 {l·l}{{\l.l}}1%
            {À}{{\`A}}1 {È}{{\`E}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ï}{{\"I}}1%
            {Ò}{{\`O}}1 {Ó}{{\'O}}1 {Ú}{{\'U}}1 {Ü}{{\"U}}1%
            {Ç}{{\c{C}}}1 {L·L}{{\L.L}}1%
}

\lstnewenvironment{shell}
     {\lstset{language=mybash,
              style=lst-common,
              backgroundcolor=\shell@background}}
     {}


\ProcessOptions\relax
